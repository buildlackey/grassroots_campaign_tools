{
  "scripts": {
    "clean": "rm -rf ../../dist/gas/gas_safe_staging",

    "prepare-stage-dir": "npm run clean && mkdir -p ../../dist/gas/gas_safe_staging",

    "copy-raw": "npm run prepare-stage-dir && cp -a ../../code/gas/src/raw/. ../../dist/gas/gas_safe_staging/",

    "compile-logic": "npm run copy-raw && tsc --project tsconfig.json --outDir ../../dist/gas/gas_safe_staging",

    "bundle": "npm run compile-logic && npx webpack --config webpack.gas.config.js",

    "dist": "npm run bundle"
  },
  "devDependencies": {
    "@types/google-apps-script": "^1.0.81",
    "typescript": "^5.4.0",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "ts-loader": "^9.5.1",
    "gas-webpack-plugin": "^2.6.0"
  }
}
