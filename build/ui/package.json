{
  "private": true,
  "name": "@app/ui",
  "scripts": {
    "lint:output": "eslint -c ./eslintrc.output.json ../../dist/ui/gas_safe_staging/*Code.html",
    "prebuild:ui": "cd ../common && npm run dist",
    "clean": "rm -rf ../../dist/ui",
    "tsc:ui": "npm run clean && tsc --project tsconfig.json",
    "rename:html": "bash ../../build/scripts/ui/normalize_ui_js_to_html.sh",
    "build:ui": "npm run tsc:ui && npm run rename:html && npm run lint:output",
    "setup:fixture": "npm run build:ui && bash ../../code/ui/test/raw/create_dialog_test_fixture.sh SettingsDialog",
    "build": "npm run setup:fixture && jest --config=jest.config.js",
    "predist": "mkdir -p ../../dist/ui/gas_safe_staging",
    "dist": "npm run build && cp -a ../../code/ui/src/raw/*.html ../../dist/ui/gas_safe_staging/"
  },
  "devDependencies": {
    "@testing-library/dom": "^9.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^18.19.126",
    "jest": "^29.7.0",
    "jsdom": "^24.0.0",
    "ts-jest": "^29.1.1",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "@types/testing-library__dom": "^7.0.2"
  }
}
